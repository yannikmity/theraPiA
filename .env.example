# Kopieren nach .env und anpassen: cp .env.example .env

# Pflicht: zufälliger Wert mit mindestens 32 Zeichen, z. B. per `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3010

# Datenbank (Defaults für die lokale Entwicklung)
POSTGRES_DB=therapia
POSTGRES_USER=therapia_user
POSTGRES_PASSWORD=therapia_dev_password

# Nur für `npm run dev` ohne Docker-Frontend
DATABASE_URL=postgresql://therapia_user:therapia_dev_password@localhost:5432/therapia

# Optional: pgAdmin (docker compose --profile tools up -d)
PGADMIN_PASSWORD=admin

# Datenbank für Tests (jeder Test legt ein eigenes Schema an und löscht es wieder)
TEST_DATABASE_URL=postgresql://therapia_user:therapia_dev_password@localhost:5432/therapia

# Optional: Einrichtungscode für den ersten Account (mind. 16 Zeichen). Lokal (localhost) nicht nötig,
# auf einer öffentlich erreichbaren Instanz Pflicht für die Einrichtung.
SETUP_TOKEN=

# Registrierung: invite (Standard), open oder closed. Der erste Account wird immer Admin.
REGISTRATION_MODE=invite

# Feedback-Widget: Ablage der Markdown-Dateien und Screenshots. Standard ohne Docker ./data/feedback (git-ignoriert),
# im Container /data/feedback (Volume feedback_data). Nur setzen, wenn ein anderer Ordner gewünscht ist.
FEEDBACK_DIR=

# Optional: Nutzungsstatistik mit einer eigenen Umami-Instanz (docs/betrieb/analytics.md).
# Beide Werte oder keiner; leer = keine Statistik, kein Script.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
