# Wegwerf-Datenbank und Dev-Server für die Screenshot-Regression (scripts/screenshots.mjs).
# Nur lokale Entwicklung, keine echten Werte. Datenbank einmalig anlegen (Postgres läuft per docker compose):
#   docker compose exec -T postgres createdb -U therapia_user therapia_screenshots
DATABASE_URL=postgresql://therapia_user:therapia_dev_password@localhost:5432/therapia_screenshots
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=screenshots-nur-lokal-0123456789abcdefghijklmnop
REGISTRATION_MODE=invite
