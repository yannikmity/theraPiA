# Domain, unter der die Instanz erreichbar ist (DNS-A-Record zeigt auf den Server).
# Beide Platzhalter durch die eigene Domain ersetzen. NEXTAUTH_URL ist Pflicht und muss mit
# https:// beginnen – mit dem Platzhalter example.org startet die App nicht.
THERAPIA_DOMAIN=therapia.example.org
NEXTAUTH_URL=https://therapia.example.org

# Image-Version (Tag aus den GitHub-Releases), "latest" nur zum Ausprobieren
THERAPIA_VERSION=latest

# Pflicht: zufällig, mindestens 32 Zeichen – z. B. `openssl rand -base64 32`
NEXTAUTH_SECRET=

# Registrierung: invite (empfohlen), open oder closed
REGISTRATION_MODE=invite

# Datenbank – Passwort zufällig wählen, z. B. `openssl rand -hex 24`
# (kein base64: Zeichen wie / oder + machen die Verbindungs-URL ungültig)
POSTGRES_DB=therapia
POSTGRES_USER=therapia
POSTGRES_PASSWORD=

# Feedback-Widget: liegt im Volume feedback_data (/data/feedback im Container). Kein Eintrag nötig.

# Optional: Nutzungsstatistik mit einer eigenen Umami-Instanz (docs/betrieb/analytics.md).
# Beide Werte oder keiner; leer = keine Statistik, kein Script.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Optional: Zeitzone des App-Containers (IANA-Name). Standard im Image: Europe/Berlin. Nur setzen, wenn die Instanz
# in einer anderen Zeitzone betrieben wird – und dann nie leer lassen (TZ= erzwingt UTC).
# TZ=Europe/Berlin
